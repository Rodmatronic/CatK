% CatK Configuration, press Q to quit
# Please edit this file with the config shell script.
# DO NOT DELETE!

#
% Kernel Version / General config ⌄
#

CATK_VERSION_CODENAME="Meow"
CATK_DEBUG_BUILD=y

#
% CPU Settings ⌄
#

CATK_ARCH_X86=y

#
% Filesystem Settings ⌄
#

CATK_MOUNT_RETRIES=5
CATK_REMOUNT_DELAY=0
CATK_EXT2=y
CATK_FAT32=n
CATK_DEVFS=y
CATK_DEVFS_INODES_MAX=128

#
% Video Settings ⌄
#

CATK_VIDEO_GENERIC=n
CATK_VGA_COLORS=n

#
% Kernel Debugging ⌄
#

CATK_SHOW_DEBUG=n
CATK_STACK_TRACE=y
CATK_SYSCALL_TRACE=y

#
# Compiler (autofilled by Makefile)
#

CATK_COMPILED_WITH="clang"
CATK_VERSION_STRING="0.1"
CATK_BUILD_DATE="Sat 30 Nov 2024 14:10:48 PST"
