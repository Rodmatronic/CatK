# CatK Configuration
# DO NOT DELETE!

#
# Kernel Version / General config
#

CATK_VERSION_STRING="Meow"

#
# CPU Settings
#

CATK_ARCH_X86=y

#
# Filesystem Settings
#

CATK_MOUNT_RETRIES=2
CATK_EXT2=y
CATK_DEVFS=y
CATK_DEVFS_INODES_MAX=128

#
# Video Settings
#

CATK_VIDEO_GENERIC=n

#
# Kernel Debugging
#

CATK_STACK_TRACE=y
CATK_SYSCALL_TRACE=y

#
# Compiler (autofilled by Makefile)
#
CATK_COMPILED_WITH="clang"
CATK_BUILD_DATE="Tue 03 Sep 2024 00:36:19 PDT"
